rules_version = '2';

/* =========================================================
   Regras de segurança do Firestore — Raízes do Sertão
   ========================================================= */

service cloud.firestore {

  match /databases/{database}/documents {


    /* =====================================================
       FUNÇÕES
       ===================================================== */

    function estaLogado() {
      return request.auth != null;
    }


    function eLideranca() {
      return estaLogado()
        &&
        request.auth.token.email
          == 'lideranca@raizesdosertao.app';
    }


    function eDaUnidade(unidadeId) {
      return estaLogado()
        &&
        request.auth.token.email
          == unidadeId + '@raizesdosertao.app';
    }


    /* =====================================================
       CONFIGURAÇÕES PÚBLICAS
       ===================================================== */

    match /config/{docId} {

      allow read: if true;

      allow write: if eLideranca();

    }


    /* =====================================================
       MÍDIA PÚBLICA
       ===================================================== */

    match /midia/{pastaId} {

      allow read: if true;

      allow write: if eLideranca();

    }


    /* =====================================================
       LAVA JATO
       ===================================================== */

    match /lavajato/{registroId} {

      // Qualquer pessoa pode criar cadastro.
      allow create: if true;


      // Apenas liderança pode ler os cadastros.
      allow read: if eLideranca();


      // Liderança pode editar tudo.
      // Visitante pode somente cancelar.
      allow update: if eLideranca() || (

        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'cancelado',
            'canceladoEm'
          ])

        &&

        request.resource.data.cancelado == true

      );


      // Apenas liderança pode excluir.
      allow delete: if eLideranca();

    }


    /* =====================================================
       MEMBROS DAS UNIDADES
       ===================================================== */

    match /unidades/{unidadeId}/membros/{membroId} {

      allow read: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);

      allow write: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);

    }


    /* =====================================================
       REGISTROS DE REQUISITOS DOS MEMBROS
       ===================================================== */

    match /unidades/{unidadeId}/membros/{membroId}/registros/{registroId} {

      allow read: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);

      allow write: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);

    }


    /* =====================================================
       TÓPICOS / ATIVIDADES / REQUISITOS
       ===================================================== */

    match /unidades/{unidadeId}/topicos/{topicoId} {

      allow read: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);

      allow write: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);

    }


    /* =====================================================
       TODO O RESTANTE É NEGADO
       ===================================================== */

    match /{document=**} {

      allow read, write: if false;

    }

  }

}
export const app = initializeApp(firebaseConfig);

export const auth = getAuth(app);

export const db = getFirestore(app);


/* =========================================================
   EMULADOR LOCAL

   Ative usando:

   ?emulator=1
   ========================================================= */

const usandoEmulador =
  typeof window !== "undefined" &&
  new URLSearchParams(window.location.search).get("emulator") === "1";


if (usandoEmulador) {
  try {
    connectAuthEmulator(
      auth,
      "http://127.0.0.1:9099",
      {
        disableWarnings: true
      }
    );

    connectFirestoreEmulator(
      db,
      "127.0.0.1",
      8080
    );

    console.log("Firebase conectado aos emuladores.");

  } catch (erro) {
    console.warn(
      "Erro ao conectar aos emuladores:",
      erro
    );
  }
}    }

    // Lava Jato: qualquer visitante pode criar um cadastro (não
    // precisa estar logado). Só a liderança lê a lista completa
    // (protege telefone/placa dos clientes de ficarem públicos).
    // Cancelamento: liberado pra quem tiver o ID do próprio
    // cadastro (guardado no navegador de quem se cadastrou) OU
    // pela liderança — mas só pode alterar os campos de
    // cancelamento, nada mais.
    match /lavajato/{registroId} {
      allow create: if true;
      allow read: if eLideranca();
      allow update: if eLideranca() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelado', 'canceladoEm']) &&
        request.resource.data.cancelado == true
      );
      allow delete: if eLideranca();
    }

    // Desbravadores de cada unidade — a própria unidade e a
    // liderança podem ler e escrever; outras unidades não.
    match /unidades/{unidadeId}/membros/{membroId} {
      allow read: if estaLogado();
      allow write: if eLideranca() || eDaUnidade(unidadeId);
    }

    // Registros de requisitos por desbravador (histórico de
    // lançamentos individuais) — mesma regra dos membros.
    match /unidades/{unidadeId}/membros/{membroId}/registros/{registroId} {
      allow read: if estaLogado();
      allow write: if eLideranca() || eDaUnidade(unidadeId);
    }
  }
}
