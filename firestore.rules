rules_version = '2';

/* =========================================================
   Regras de segurança do Firestore — Raízes do Sertão
   ========================================================= */

service cloud.firestore {

  match /databases/{database}/documents {


    /* =====================================================
       FUNÇÕES
       ===================================================== */

    function estaLogado() {
      return request.auth != null;
    }


    function eLideranca() {
      return estaLogado()
        &&
        request.auth.token.email
          == 'lideranca@raizesdosertao.app';
    }


    function eDaUnidade(unidadeId) {
      return estaLogado()
        &&
        request.auth.token.email
          == unidadeId + '@raizesdosertao.app';
    }


    /* =====================================================
       CONFIGURAÇÕES PÚBLICAS
       ===================================================== */

    match /config/{docId} {

      allow read: if true;

      allow write: if eLideranca();

    }


    /* =====================================================
       MÍDIA PÚBLICA
       ===================================================== */

    match /midia/{pastaId} {

      allow read: if true;

      allow write: if eLideranca();

    }


    /* =====================================================
       LAVA JATO
       ===================================================== */

    match /lavajato/{registroId} {

      // Qualquer pessoa pode criar cadastro.
      allow create: if true;


      // Apenas liderança pode ler os cadastros.
      allow read: if eLideranca();


      // Liderança pode editar tudo.
      // Visitante pode somente cancelar.
      allow update: if eLideranca() || (

        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'cancelado',
            'canceladoEm'
          ])

        &&

        request.resource.data.cancelado == true

      );


      // Apenas liderança pode excluir.
      allow delete: if eLideranca();

    }


    /* =====================================================
       MEMBROS DAS UNIDADES
       ===================================================== */

    match /unidades/{unidadeId}/membros/{membroId} {

      allow read: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);

      allow write: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);

    }


    /* =====================================================
       REGISTROS DE REQUISITOS DOS MEMBROS
       ===================================================== */

    match /unidades/{unidadeId}/membros/{membroId}/registros/{registroId} {

      allow read: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);

      allow write: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);

    }


    /* =====================================================
       TÓPICOS / ATIVIDADES / REQUISITOS
       ===================================================== */

    match /unidades/{unidadeId}/topicos/{topicoId} {

      allow read: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);

      allow write: if
        eLideranca()
        ||
        eDaUnidade(unidadeId);
rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function eLideranca() {
      return estaLogado()
        && request.auth.token.email == 'lideranca@raizesdosertao.app';
    }

    function eDaUnidade(unidadeId) {
      return estaLogado()
        && request.auth.token.email == unidadeId + '@raizesdosertao.app';
    }


    /* CONFIGURAÇÕES */

    match /config/{docId} {
      allow read: if true;
      allow write: if eLideranca();
    }


    /* MÍDIA */

    match /midia/{pastaId} {
      allow read: if true;
      allow write: if eLideranca();
    }


    /* LAVA JATO */

    match /lavajato/{registroId} {

      allow create: if true;

      allow read: if eLideranca();

      allow update: if
        eLideranca()
        ||
        (
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'cancelado',
              'canceladoEm'
            ])
          &&
          request.resource.data.cancelado == true
        );

      allow delete: if eLideranca();
    }


    /* MEMBROS */

    match /unidades/{unidadeId}/membros/{membroId} {

      allow read, write:
        if eLideranca()
        || eDaUnidade(unidadeId);
    }


    /* REGISTROS */

    match /unidades/{unidadeId}/membros/{membroId}/registros/{registroId} {

      allow read, write:
        if eLideranca()
        || eDaUnidade(unidadeId);
    }


    /* TÓPICOS */

    match /unidades/{unidadeId}/topicos/{topicoId} {

      allow read, write:
        if eLideranca()
        || eDaUnidade(unidadeId);
    }


    /* BLOQUEIO PADRÃO */

    match /{document=**} {
      allow read, write: if false;
    }

  }

}
